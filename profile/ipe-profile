#!/bin/sh
# Install the PHP extensions of one profile (used by the Dockerfile at the
# repo root; shipped in the image as /usr/local/bin/ipe-profile).
# Usage: ipe-profile <ext>[-<version>]...
#
# * install-php-extensions with retries (ipe-retry): pecl.php.net is flaky.
# * Debian: the memcached build needs libssl-dev + libsasl2-dev (required by
#   libmemcached.pc), which install-php-extensions does not pull in on
#   Debian 12. They are installed for the build only and purged afterwards
#   (unless they were already present).
# * PHP 7.4 backport images link ext/openssl against a private OpenSSL 1.1.1
#   (/usr/local/openssl-1.1). install-php-extensions derives Debian package
#   names from that version and asks for "libssl1.1", which bookworm does not
#   have, so on those images every extension is built here instead
#   (docker-php-ext-install for bundled ones, phpize for the verified PECL
#   sources) against Debian's libraries.
# * PECL packages are pinned by version AND sha256 and fetched here (curl with
#   retries), first from pecl.php.net, then from the project's GitHub tag
#   archive; install-php-extensions gets the verified source directory.
#   pecl.php.net often answers 500 or times out, and pecl itself does not
#   honour https_proxy.
set -eu

# <name-version> <pecl.php.net tgz sha256> <github repo> <tag> <github tgz sha256> [<submodule>]
# <submodule> = <dir>:<github repo>@<commit>=<tgz sha256>, for git submodules
# missing from GitHub tag archives (pecl tarballs include them).
PECL_PINS='
apcu-5.1.28 ca9c1820810a168786f8048a4c3f8c9e3fd941407ad1553259fb2e30b5f057bf krakjoe/apcu v5.1.28 0e60ba9d0fa4021c57a70c071f3d8f71de236275d084e560d5959fec4edd8c32
imagick-3.8.1 3a3587c0a524c17d0dad9673a160b90cd776e836838474e173b549ed864352ee Imagick/imagick 3.8.1 b0e9279ddf6e75a8c6b4068e16daec0475427dbca7ce2e144e30a51a88aa5ddc
memcached-3.4.0 c163434eb0da97c8f45c7ad41d979d381f8b81c49402b1b90b063987fb37972e php-memcached-dev/php-memcached v3.4.0 10b98a0fdc3ce9ab823db59e8935f068de87e374728871a1efacdadd8c7807d1
redis-6.3.0 0d5141f634bd1db6c1ddcda053d25ecf2c4fc1c395430d534fd3f8d51dd7f0b5 phpredis/phpredis 6.3.0 cb8f81df1a275599e4f8ddcfec7e1f65ed1953e6f5673649149fd680ebff4cad liblzf:nemequ/liblzf@fb25820c3c0aeafd127956ae6c115063b47e459a=8e425b5bf7a569543e29cb4a16a913445d80c4efe83b371760ca798ca9b819ed
xdebug-3.5.3 f073de91bea046106abf4d6071c963ea71e58571df6ce58948ceca89d121cb2d xdebug/xdebug 3.5.3 954e56021668121ecc50b92d2ad1ce945f22ecf81ffc5bb5835219485b12ef5f
'
SRC=/tmp/ipe-profile-src

# fetch <name-version>: print the verified source dir (with package.xml)
fetch() {
	line=$(printf '%s\n' "$PECL_PINS" | awk -v k="$1" '$1==k')
	[ -n "$line" ] || { echo "ipe-profile: $1 is not pinned in PECL_PINS" >&2; return 1; }
	# shellcheck disable=SC2086 # split the pin line into fields
	set -- $line
	mkdir -p "$SRC"
	f="$SRC/$1.tgz" d="$SRC/$1"
	rm -rf "$d"; mkdir -p "$d"
	# IPE_PROFILE_FORCE_GITHUB=1 skips pecl.php.net (to test the fallback)
	if [ "${IPE_PROFILE_FORCE_GITHUB:-}" != 1 ] && curl -fsSL --retry 4 --retry-all-errors --retry-delay 10 --connect-timeout 20 --max-time 90 \
			-o "$f" "https://pecl.php.net/get/$1.tgz" \
		&& echo "$2 *$f" | sha256sum -c - >&2; then
		# pecl layout: package.xml next to <name-version>/
		tar -xzf "$f" -C "$d"
		mv "$d/package.xml" "$d/$1/"
		echo "$d/$1"
		return 0
	fi
	echo "ipe-profile: pecl.php.net failed for $1, using github.com/$3 $4" >&2
	curl -fsSL --retry 4 --retry-all-errors --retry-delay 10 --connect-timeout 20 --max-time 90 \
		-o "$f" "https://codeload.github.com/$3/tar.gz/refs/tags/$4"
	echo "$5 *$f" | sha256sum -c - >&2
	tar -xzf "$f" -C "$d" --strip-components=1
	if [ $# -ge 6 ]; then
		sub=${6%%:*} r=${6#*:}
		repo=${r%%@*} r=${r#*@}
		commit=${r%%=*} sum=${r#*=}
		curl -fsSL --retry 4 --retry-all-errors --retry-delay 10 --connect-timeout 20 --max-time 90 \
			-o "$f.sub" "https://codeload.github.com/$repo/tar.gz/$commit"
		echo "$sum *$f.sub" | sha256sum -c - >&2
		mkdir -p "$d/$sub"
		tar -xzf "$f.sub" -C "$d/$sub" --strip-components=1
	fi
	echo "$d"
}

deb_extra=""
if [ -f /etc/debian_version ]; then
	for p in libssl-dev libsasl2-dev; do
		dpkg -s "$p" >/dev/null 2>&1 || deb_extra="$deb_extra $p"
	done
fi

# PHP 7.4 backport images: everything is built here (see header)
legacy=no
[ -d /usr/local/openssl-1.1 ] && legacy=yes

bundled="" pecl_dirs="" ipe_args=""
for e in "$@"; do
	case "$e" in
		*-[0-9]*)   # pinned PECL package
			src=$(fetch "$e")
			pecl_dirs="$pecl_dirs ${e%%-[0-9]*}=$src"
			ipe_args="$ipe_args $src"
			;;
		*)          # extension bundled with PHP
			bundled="$bundled $e"
			ipe_args="$ipe_args $e"
			;;
	esac
done

if [ -n "$deb_extra" ]; then
	apt-get update
	# shellcheck disable=SC2086
	apt-get install -y --no-install-recommends $deb_extra
fi

rc=0
if [ "$legacy" = no ]; then
	# shellcheck disable=SC2086
	ipe-retry $ipe_args || rc=$?
else
	savedAptMark="$(apt-mark showmanual)"
	devs=""
	for e in $bundled; do
		case "$e" in
			gd) devs="$devs libfreetype-dev libjpeg62-turbo-dev libpng-dev libwebp-dev libxpm-dev" ;;
			intl) devs="$devs libicu-dev" ;;
			ldap) devs="$devs libldap2-dev" ;;
			soap) devs="$devs libxml2-dev" ;;
			zip) devs="$devs libzip-dev" ;;
			bcmath|exif|mysqli|pdo_mysql|pcntl|sockets) ;;
			*) echo "ipe-profile: no PHP 7.4 recipe for $e" >&2; exit 1 ;;
		esac
	done
	for pd in $pecl_dirs; do
		case "${pd%%=*}" in
			imagick) devs="$devs libmagickwand-dev" ;;
			memcached) devs="$devs libmemcached-dev zlib1g-dev" ;;
			*) echo "ipe-profile: no PHP 7.4 recipe for ${pd%%=*}" >&2; exit 1 ;;
		esac
	done
	apt-get update
	# shellcheck disable=SC2086
	[ -z "$devs" ] || apt-get install -y --no-install-recommends $devs
	multiarch="$(dpkg-architecture --query DEB_BUILD_MULTIARCH)"
	case " $bundled " in *" gd "*)
		docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp --with-xpm ;;
	esac
	case " $bundled " in *" ldap "*)
		docker-php-ext-configure ldap --with-libdir="lib/$multiarch" --with-ldap-sasl ;;
	esac
	# shellcheck disable=SC2086
	[ -z "$bundled" ] || docker-php-ext-install -j"$(nproc)" $bundled
	for pd in $pecl_dirs; do
		( cd "${pd#*=}" && phpize && ./configure && make -j"$(nproc)" && make install )
		docker-php-ext-enable "${pd%%=*}"
	done
	# keep only the runtime libraries the new extensions link to
	apt-mark auto '.*' >/dev/null
	# shellcheck disable=SC2086
	[ -z "$savedAptMark" ] || apt-mark manual $savedAptMark >/dev/null
	find /usr/local/lib/php/extensions -type f -name '*.so' -exec ldd '{}' ';' \
		| awk '/=>/ { so = $(NF-1); if (index(so, "/usr/local/") == 1) { next }; gsub("^/(usr/)?", "", so); printf "*%s\n", so }' \
		| sort -u \
		| xargs -r dpkg-query --search \
		| awk 'sub(":$", "", $1) { print $1 }' \
		| sort -u \
		| xargs -r apt-mark manual
	apt-get purge -y --auto-remove -o APT::AutoRemove::RecommendsImportant=false
	docker-php-source delete
fi

if [ -n "$deb_extra" ]; then
	# shellcheck disable=SC2086
	apt-get purge -y $deb_extra
fi
[ ! -f /etc/debian_version ] || rm -rf /var/lib/apt/lists/*
rm -rf "$SRC"
exit "$rc"
